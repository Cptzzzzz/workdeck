# 复制为 .env.deploy.local，修改私有部署值；不要提交本地文件。
WORKDECK_SSH_TARGET=deploy@server.example.com
WORKDECK_PUBLIC_URL=https://work.example.com
WORKDECK_DEPLOY_DIR=/opt/stacks/workdeck
WORKDECK_DOCKER_NETWORK=public-apps_default
WORKDECK_CADDY_DIR=/opt/stacks/public-apps/caddy
WORKDECK_CADDY_CONTAINER=caddy
# 可选：实际反向代理网段，用于正确区分登录限流的客户端。
WORKDECK_TRUSTED_PROXY_CIDR=172.20.0.0/16
# 设备登录有效期，默认 30 天，活跃使用时续期。
WORKDECK_SESSION_TTL=720h
# 可选：启用 Tailnet 探测前，先配置宿主机探测服务和共享密钥。
# WORKDECK_TAILNET_PROBE_URL=https://machine.tailnet.ts.net:18443/probe
# 显式关闭已启用的探测时设置为 1；平时留空。
# WORKDECK_TAILNET_PROBE_DISABLE=1
